{
  "name": "steward",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": "11.16.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "start": "next start",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.13.2",
    "@types/pg": "8.15.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "0.31.10",
    "jsdom": "26.1.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vitest": "4.1.10",
    "prettier": "3.9.6"
  },
  "type": "module",
  "dependencies": {
    "@next/env": "16.4.6",
    "better-auth": "1.7.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.44.0",
    "next": "16.4.6",
    "pg": "8.16.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "7.87.0",
    "server-only": "0.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  }
}
