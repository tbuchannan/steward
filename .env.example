# Copy to .env.local at the repository root. Use a unique secret per environment.
DATABASE_URL=postgresql://steward:steward@localhost:5432/steward
# Hosted app: use the Neon pooled URL from the Connect dialog, retaining TLS parameters.
# For db:migrate, set DATABASE_URL in the migration shell to the direct Neon URL
# for the same branch/database. See docs/operations/configuration.md.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
