{
  "name": "@steward/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include \"../../packages/contracts/dist/**/*.js\" src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@steward/contracts": "workspace:*",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.16.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.10",
    "oxlint": "1.71.0",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
